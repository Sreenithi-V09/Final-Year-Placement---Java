Solution

import java.io.*;
import java.util.*;
import java.text.*;
import java.math.*;
import java.util.regex.*;

public class Solution {

    public static void main(String[] args) {
        /* Enter your code here. Read input from STDIN. Print output to STDOUT. Your class should be named Solution. */
        Scanner scan = new Scanner(System.in);
        int num = scan.nextInt();
        if(num>=0 && num<=9){
            switch(num){
                case 0:
                    System.out.print("Integer is "+num+" and String is Zero");
                    break;
                case 1:
                    System.out.print("Integer is "+num+" and String is One");
                    break;
                case 2:
                    System.out.print("Integer is "+num+" and String is Two");
                    break;
                case 3:
                    System.out.print("Integer is "+num+" and String is Three");
                    break;
                case 4:
                    System.out.print("Integer is "+num+" and String is Four");
                    break;
                case 5:
                    System.out.print("Integer is "+num+" and String is Five");
                    break;
                case 6:
                    System.out.print("Integer is "+num+" and String is Six");
                    break;
                case 7:
                    System.out.print("Integer is "+num+" and String is Seven");
                    break;
                case 8:
                    System.out.print("Integer is "+num+" and String is Eight");
                    break;
                case 9:
                    System.out.print("Integer is "+num+" and String is Nine");
                    break;
                default :
                    System.out.print("Invalid Input"); 
                    break;
            }
        }
        else{
            System.out.print("Invalid Input"); 
        }
    }
}
