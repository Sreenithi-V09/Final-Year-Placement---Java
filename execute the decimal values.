import java.io.*;
import java.util.*;
import java.text.*;
import java.math.*;
import java.util.regex.*;

public class Solution {

    public static void main(String[] args) {
        /* Enter your code here. Read input from STDIN. Print output to STDOUT. Your class should be named Solution. */
        Scanner scan = new Scanner(System.in);
        float a = scan.nextFloat();
        System.out.println(a);
        System.out.printf("%.4f\n",Math.ceil(a*10000)/10000);
        float b=Math.round(a*1000);
        System.out.printf("%.3f\n",b/1000);
        float d=Math.round(a*100);
        System.out.printf("%.2f\n",d/100);
        float c=Math.round(a*10);
        System.out.printf("%.01f\n",c/10);
        System.out.println((int)a);
    }
}
